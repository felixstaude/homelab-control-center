# Homelab Control Center — control plane configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is gitignored. NEVER commit real credentials.
#
# Every variable is prefixed HCC_ and maps to a field on hcc.config.Settings.
# Invalid or missing required values make the process exit with a readable
# error at startup rather than failing later.

# --- Core -------------------------------------------------------------------
# One of: development | test | production
HCC_ENVIRONMENT=development
HCC_DEBUG=false

# --- HTTP -------------------------------------------------------------------
# Bind to loopback in development. Use 0.0.0.0 only inside a container where
# the port is deliberately published.
HCC_HOST=127.0.0.1
HCC_PORT=8000
HCC_API_PREFIX=/api

# Browser origins allowed to call the API, as a JSON array.
# Production serves the web client same-origin and needs no entries here.
# Development needs the Vite dev server:
HCC_CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---------------------------------------------------------------
# REQUIRED. Plain postgresql:// form; the asyncpg driver is applied internally.
# These credentials match deploy/compose.yaml for local development ONLY.
# Generate a real password for any non-local deployment.
HCC_DATABASE_URL=postgresql://hcc:hcc_local_dev@localhost:5432/hcc

HCC_DATABASE_POOL_SIZE=5
HCC_DATABASE_MAX_OVERFLOW=10
# `queue` keeps connections open between requests, which is what a long-running
# server wants. Use `null` behind an external pooler such as PgBouncer, which
# pools itself and for which a second layer causes session-state bugs.
HCC_DATABASE_POOL_CLASS=queue
# Logs every SQL statement. Useful when debugging, very noisy otherwise.
HCC_DATABASE_ECHO=false

# --- Password hashing -------------------------------------------------------
# Argon2id cost parameters. Defaults are RFC 9106's "low memory" (second
# recommended) profile, which is also what argon2-cffi ships.
#
# IMPORTANT: memory is charged PER CONCURRENT HASH, not globally. At the
# default 65536 KiB, ten simultaneous logins transiently need ~640 MiB. Size
# against concurrent logins, not against one.
#
# Reference timings (20-core desktop): ~50 ms per hash at the defaults,
# ~115 ms with parallelism=1. On constrained hardware — a Raspberry Pi, a
# small VPS — tune memory down rather than accepting swap.
#
# Floors are enforced (memory >= 19456 KiB, time >= 2, parallelism >= 1), so
# these can be tuned for weak hardware but not configured into uselessness.
# See apps/server/hcc/security/password.py and ADR-025.
HCC_PASSWORD_HASH_MEMORY_COST=65536
HCC_PASSWORD_HASH_TIME_COST=3
HCC_PASSWORD_HASH_PARALLELISM=4

# --- Sessions ---------------------------------------------------------------
# Server-side sessions; the cookie carries an opaque random token and only its
# SHA-256 hash is stored. See apps/server/hcc/models/session.py, ADR-027,
# ADR-028.
HCC_SESSION_COOKIE_NAME=hcc_session
# Absolute lifetime: a session dies this long after login regardless of
# activity, bounding the damage from a stolen cookie. 12 hours.
HCC_SESSION_LIFETIME_SECONDS=43200
# Idle timeout, from last use. 0 disables it, leaving only the absolute
# lifetime.
HCC_SESSION_IDLE_TIMEOUT_SECONDS=3600
# `last_seen_at` is rewritten at most once per this interval, so an active
# session does not cause a database write on every request.
HCC_SESSION_TOUCH_INTERVAL_SECONDS=60
# Leave unset to derive the `Secure` cookie flag from HCC_ENVIRONMENT: on in
# production, off elsewhere so plain-HTTP local development works. Setting it
# false in production is REFUSED at startup, because session cookies would
# then travel in clear. Terminate TLS at a reverse proxy.
# HCC_SESSION_COOKIE_SECURE=
# lax | strict | none. `strict` drops the cookie when a user follows a link to
# the dashboard from elsewhere, which reads as a random logout.
HCC_SESSION_COOKIE_SAMESITE=lax
HCC_CSRF_COOKIE_NAME=hcc_csrf
HCC_CSRF_HEADER_NAME=X-CSRF-Token

# --- Login throttling -------------------------------------------------------
# Checked BEFORE password verification, because each attempt costs ~64 MiB and
# ~50 ms by design. Two independent budgets; both must allow an attempt.
#
# NOTE: counters live in this process's memory. Several uvicorn workers each
# get their own, multiplying the effective limit. Deploy with one worker until
# that is addressed. See ADR-029.
HCC_LOGIN_RATE_LIMIT_PER_ADDRESS=20
HCC_LOGIN_RATE_LIMIT_PER_USERNAME=10
HCC_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# Headers a reverse proxy sets to report the real client address, as a JSON
# array. EMPTY BY DEFAULT ON PURPOSE: these are client-supplied, so trusting
# them without a proxy that overwrites them lets any caller forge its address
# and bypass the per-address budget entirely.
# HCC_TRUSTED_PROXY_HEADERS=["x-forwarded-for"]

# --- Security headers -------------------------------------------------------
HCC_SECURITY_HEADERS_ENABLED=true
# Leave unset to derive from HCC_ENVIRONMENT. A Content-Security-Policy strict
# enough to be worth having breaks the Vite dev server, which needs inline
# scripts and a websocket for hot reload.
# HCC_CONTENT_SECURITY_POLICY_ENABLED=

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
HCC_LOG_LEVEL=INFO
# `console` for readable local output, `json` for production log ingestion.
HCC_LOG_FORMAT=console
