# Homelab Control Center — control plane configuration
#
# Copy to `.env` and adjust:   cp .env.example .env
# `.env` is gitignored. NEVER commit real credentials.
#
# Every variable is prefixed HCC_ and maps to a field on hcc.config.Settings.
# Invalid or missing required values make the process exit with a readable
# error at startup rather than failing later.

# --- Core -------------------------------------------------------------------
# One of: development | test | production
HCC_ENVIRONMENT=development
HCC_DEBUG=false

# --- HTTP -------------------------------------------------------------------
# Bind to loopback in development. Use 0.0.0.0 only inside a container where
# the port is deliberately published.
HCC_HOST=127.0.0.1
HCC_PORT=8000
HCC_API_PREFIX=/api

# Browser origins allowed to call the API, as a JSON array.
# Production serves the web client same-origin and needs no entries here.
# Development needs the Vite dev server:
HCC_CORS_ORIGINS=["http://localhost:5173"]

# --- Database ---------------------------------------------------------------
# REQUIRED. Plain postgresql:// form; the asyncpg driver is applied internally.
# These credentials match deploy/compose.yaml for local development ONLY.
# Generate a real password for any non-local deployment.
HCC_DATABASE_URL=postgresql://hcc:hcc_local_dev@localhost:5432/hcc

HCC_DATABASE_POOL_SIZE=5
HCC_DATABASE_MAX_OVERFLOW=10
# Logs every SQL statement. Useful when debugging, very noisy otherwise.
HCC_DATABASE_ECHO=false

# --- Password hashing -------------------------------------------------------
# Argon2id cost parameters. Defaults are RFC 9106's "low memory" (second
# recommended) profile, which is also what argon2-cffi ships.
#
# IMPORTANT: memory is charged PER CONCURRENT HASH, not globally. At the
# default 65536 KiB, ten simultaneous logins transiently need ~640 MiB. Size
# against concurrent logins, not against one.
#
# Reference timings (20-core desktop): ~50 ms per hash at the defaults,
# ~115 ms with parallelism=1. On constrained hardware — a Raspberry Pi, a
# small VPS — tune memory down rather than accepting swap.
#
# Floors are enforced (memory >= 19456 KiB, time >= 2, parallelism >= 1), so
# these can be tuned for weak hardware but not configured into uselessness.
# See apps/server/hcc/security/password.py and ADR-025.
HCC_PASSWORD_HASH_MEMORY_COST=65536
HCC_PASSWORD_HASH_TIME_COST=3
HCC_PASSWORD_HASH_PARALLELISM=4

# --- Logging ----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
HCC_LOG_LEVEL=INFO
# `console` for readable local output, `json` for production log ingestion.
HCC_LOG_FORMAT=console
