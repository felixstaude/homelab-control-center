# Homelab Control Center — web client configuration
#
# Copy to `.env.local` for local overrides:  cp .env.example .env.local
# `.env*` files are gitignored except this example. NEVER commit secrets.
#
# Only variables prefixed `VITE_` are exposed to the browser. Anything placed
# here is PUBLIC: it is embedded verbatim into the built JavaScript bundle.
# Never put a token, password or API key in this file.

# Base URL for control plane API requests.
#
# Leave empty (the default) to use same-origin relative requests. That is
# correct for both development — the Vite dev server proxies /api to the
# backend, see vite.config.ts — and production, where the built client is
# served by the same origin as the API.
#
# Set this only when deliberately pointing the client at a different origin,
# which also requires adding that origin to HCC_CORS_ORIGINS on the server.
VITE_API_BASE_URL=
