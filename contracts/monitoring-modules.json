{
  "document_version": 1,
  "max_interval_seconds": 2592000,
  "min_interval_seconds": 1,
  "modules": [
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 10,
      "description": "Aggregate and optional per-core CPU utilisation, from /proc/stat. Computed from the difference between two samples.",
      "id": "cpu",
      "metrics": [
        {
          "id": "utilisation",
          "kind": "gauge",
          "label_keys": [],
          "name": "CPU utilisation",
          "unit": "percent"
        },
        {
          "id": "core_utilisation",
          "kind": "gauge",
          "label_keys": [
            "core"
          ],
          "name": "Per-core utilisation",
          "unit": "percent"
        },
        {
          "id": "logical_cpus",
          "kind": "gauge",
          "label_keys": [],
          "name": "Logical CPUs",
          "unit": "count"
        }
      ],
      "min_interval_seconds": 1,
      "name": "CPU utilisation",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 10,
      "description": "Total, available and used memory from /proc/meminfo. Uses MemAvailable, which is the kernel's own estimate of what a new workload could claim.",
      "id": "memory",
      "metrics": [
        {
          "id": "utilisation",
          "kind": "gauge",
          "label_keys": [],
          "name": "Memory used",
          "unit": "percent"
        },
        {
          "id": "total",
          "kind": "gauge",
          "label_keys": [],
          "name": "Total memory",
          "unit": "bytes"
        },
        {
          "id": "available",
          "kind": "gauge",
          "label_keys": [],
          "name": "Available memory",
          "unit": "bytes"
        },
        {
          "id": "used",
          "kind": "gauge",
          "label_keys": [],
          "name": "Used memory",
          "unit": "bytes"
        }
      ],
      "min_interval_seconds": 1,
      "name": "Memory",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 10,
      "description": "Swap total and usage from /proc/meminfo. Reports unavailable on a host with no swap configured, rather than reporting zero usage of nothing.",
      "id": "swap",
      "metrics": [
        {
          "id": "utilisation",
          "kind": "gauge",
          "label_keys": [],
          "name": "Swap used",
          "unit": "percent"
        },
        {
          "id": "total",
          "kind": "gauge",
          "label_keys": [],
          "name": "Total swap",
          "unit": "bytes"
        },
        {
          "id": "used",
          "kind": "gauge",
          "label_keys": [],
          "name": "Used swap",
          "unit": "bytes"
        }
      ],
      "min_interval_seconds": 1,
      "name": "Swap",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 30,
      "description": "The 1, 5 and 15-minute load averages from /proc/loadavg. A count of runnable and uninterruptible processes \u2014 not a CPU percentage.",
      "id": "load",
      "metrics": [
        {
          "id": "average",
          "kind": "gauge",
          "label_keys": [
            "window"
          ],
          "name": "Load average",
          "unit": "load"
        }
      ],
      "min_interval_seconds": 5,
      "name": "Load average",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 300,
      "description": "How long the host has been running, from /proc/uptime. The host's uptime, which is not the agent process's uptime.",
      "id": "uptime",
      "metrics": [
        {
          "id": "seconds",
          "kind": "gauge",
          "label_keys": [],
          "name": "System uptime",
          "unit": "seconds"
        }
      ],
      "min_interval_seconds": 60,
      "name": "System uptime",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 60,
      "description": "Capacity, usage and inode usage per mounted filesystem, from statfs and /proc/self/mountinfo. Filesystem capacity, which is not disk capacity.",
      "id": "filesystem",
      "metrics": [
        {
          "id": "total",
          "kind": "gauge",
          "label_keys": [
            "mount"
          ],
          "name": "Filesystem size",
          "unit": "bytes"
        },
        {
          "id": "used",
          "kind": "gauge",
          "label_keys": [
            "mount"
          ],
          "name": "Used",
          "unit": "bytes"
        },
        {
          "id": "available",
          "kind": "gauge",
          "label_keys": [
            "mount"
          ],
          "name": "Available",
          "unit": "bytes"
        },
        {
          "id": "utilisation",
          "kind": "gauge",
          "label_keys": [
            "mount"
          ],
          "name": "Used",
          "unit": "percent"
        },
        {
          "id": "inodes_utilisation",
          "kind": "gauge",
          "label_keys": [
            "mount"
          ],
          "name": "Inodes used",
          "unit": "percent"
        },
        {
          "id": "readonly",
          "kind": "gauge",
          "label_keys": [
            "mount"
          ],
          "name": "Mounted read-only",
          "unit": "count"
        }
      ],
      "min_interval_seconds": 10,
      "name": "Filesystem usage",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 10,
      "description": "Read and write throughput and operation rates per block device, from /proc/diskstats. Computed from the difference between two samples.",
      "id": "diskio",
      "metrics": [
        {
          "id": "read_bytes",
          "kind": "gauge",
          "label_keys": [
            "device"
          ],
          "name": "Read throughput",
          "unit": "bytes_per_second"
        },
        {
          "id": "write_bytes",
          "kind": "gauge",
          "label_keys": [
            "device"
          ],
          "name": "Write throughput",
          "unit": "bytes_per_second"
        },
        {
          "id": "read_ops",
          "kind": "gauge",
          "label_keys": [
            "device"
          ],
          "name": "Reads",
          "unit": "operations_per_second"
        },
        {
          "id": "write_ops",
          "kind": "gauge",
          "label_keys": [
            "device"
          ],
          "name": "Writes",
          "unit": "operations_per_second"
        },
        {
          "id": "utilisation",
          "kind": "gauge",
          "label_keys": [
            "device"
          ],
          "name": "Busy",
          "unit": "percent"
        }
      ],
      "min_interval_seconds": 1,
      "name": "Disk throughput",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 10,
      "description": "Throughput, packet rates, errors and link state per interface, from /proc/net/dev and /sys/class/net. Computed from the difference between two samples.",
      "id": "network",
      "metrics": [
        {
          "id": "receive_bytes",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Download",
          "unit": "bytes_per_second"
        },
        {
          "id": "transmit_bytes",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Upload",
          "unit": "bytes_per_second"
        },
        {
          "id": "receive_packets",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Packets in",
          "unit": "packets_per_second"
        },
        {
          "id": "transmit_packets",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Packets out",
          "unit": "packets_per_second"
        },
        {
          "id": "receive_errors",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Receive errors",
          "unit": "packets_per_second"
        },
        {
          "id": "transmit_errors",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Transmit errors",
          "unit": "packets_per_second"
        },
        {
          "id": "receive_drops",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Receive drops",
          "unit": "packets_per_second"
        },
        {
          "id": "transmit_drops",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Transmit drops",
          "unit": "packets_per_second"
        },
        {
          "id": "up",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Link up",
          "unit": "count"
        },
        {
          "id": "speed",
          "kind": "gauge",
          "label_keys": [
            "interface"
          ],
          "name": "Link speed",
          "unit": "bits_per_second"
        }
      ],
      "min_interval_seconds": 1,
      "name": "Network traffic",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 30,
      "description": "Temperature and fan readings from /sys/class/hwmon, named by the chip that reports them. Only what the hardware actually exposes \u2014 a host with no sensors reports the module unavailable rather than inventing one.",
      "id": "sensors",
      "metrics": [
        {
          "id": "temperature",
          "kind": "gauge",
          "label_keys": [
            "sensor"
          ],
          "name": "Temperature",
          "unit": "celsius"
        },
        {
          "id": "fan_speed",
          "kind": "gauge",
          "label_keys": [
            "sensor"
          ],
          "name": "Fan speed",
          "unit": "rpm"
        }
      ],
      "min_interval_seconds": 5,
      "name": "Temperatures and fans",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 15,
      "description": "Container state, CPU, memory and network from the Docker Engine API. Read-only. Needs the host administrator to grant socket access first: the Docker socket is equivalent to root.",
      "id": "docker",
      "metrics": [
        {
          "id": "containers_total",
          "kind": "gauge",
          "label_keys": [],
          "name": "Containers",
          "unit": "count"
        },
        {
          "id": "containers_running",
          "kind": "gauge",
          "label_keys": [],
          "name": "Running",
          "unit": "count"
        },
        {
          "id": "running",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Running",
          "unit": "count"
        },
        {
          "id": "cpu_utilisation",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "CPU",
          "unit": "percent"
        },
        {
          "id": "memory_bytes",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Memory",
          "unit": "bytes"
        },
        {
          "id": "memory_limit",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Memory limit",
          "unit": "bytes"
        },
        {
          "id": "memory_utilisation",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Memory used",
          "unit": "percent"
        },
        {
          "id": "receive_bytes",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Download",
          "unit": "bytes_per_second"
        },
        {
          "id": "transmit_bytes",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Upload",
          "unit": "bytes_per_second"
        },
        {
          "id": "restart_count",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Restarts",
          "unit": "count"
        },
        {
          "id": "uptime_seconds",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Uptime",
          "unit": "seconds"
        },
        {
          "id": "healthy",
          "kind": "gauge",
          "label_keys": [
            "container"
          ],
          "name": "Healthy",
          "unit": "count"
        }
      ],
      "min_interval_seconds": 5,
      "name": "Containers",
      "platform": "linux",
      "requires_privileges": true,
      "schedule_kinds": [
        "interval"
      ]
    },
    {
      "allows_duplicate_runs": true,
      "data_schema_version": 1,
      "default_interval_seconds": 60,
      "description": "State, restart count and uptime for named systemd units, plus the host's failed-unit count. Read-only. Names the units to watch, because a host has hundreds and almost none of them are interesting.",
      "id": "systemd",
      "metrics": [
        {
          "id": "units_failed",
          "kind": "gauge",
          "label_keys": [],
          "name": "Failed units",
          "unit": "count"
        },
        {
          "id": "active",
          "kind": "gauge",
          "label_keys": [
            "unit"
          ],
          "name": "Active",
          "unit": "count"
        },
        {
          "id": "failed",
          "kind": "gauge",
          "label_keys": [
            "unit"
          ],
          "name": "Failed",
          "unit": "count"
        },
        {
          "id": "restarts",
          "kind": "gauge",
          "label_keys": [
            "unit"
          ],
          "name": "Restarts",
          "unit": "count"
        },
        {
          "id": "enabled",
          "kind": "gauge",
          "label_keys": [
            "unit"
          ],
          "name": "Enabled at boot",
          "unit": "count"
        },
        {
          "id": "uptime_seconds",
          "kind": "gauge",
          "label_keys": [
            "unit"
          ],
          "name": "Running for",
          "unit": "seconds"
        }
      ],
      "min_interval_seconds": 15,
      "name": "Services",
      "platform": "linux",
      "requires_privileges": false,
      "schedule_kinds": [
        "interval"
      ]
    }
  ],
  "registry_version": 1
}
