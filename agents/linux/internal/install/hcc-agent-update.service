; The privileged half of a controller-driven agent update.
;
; THIS FILE IS THE INSTALLED UNIT, embedded into the agent binary and written
; verbatim to /etc/systemd/system/hcc-agent-update.service. There is no second
; copy to drift from it, and `hcc-agent install --dry-run` prints these bytes.
;
; # Why this unit exists
;
; hcc-agent.service runs as an unprivileged account, which is the single most
; important fact about it: a long-lived network-facing process should not be
; root. An unprivileged process also cannot replace a root-owned binary in
; /usr/local/bin or restart its own unit — so it cannot install an update.
;
; The two ways out are running the agent as root, or moving the install step
; into a short-lived root unit that does one bounded thing. This is the second.
;
; # What stops this becoming "agent user can run anything as root"
;
; The request file is written by the unprivileged agent, so the agent user can
; make root run THIS unit whenever it likes. What it cannot do is choose what
; gets installed:
;
;   * The request carries the publisher's **signed release metadata** and the
;     detached signature, not a digest. `hcc-agent apply-update` verifies that
;     signature against the key compiled into this binary, and takes the
;     expected SHA-256 out of the verified metadata.
;   * So there is no digest field to forge. A compromised agent account can
;     cause root to install a genuinely published, publisher-signed release of
;     this agent, and nothing else.
;   * The archive is required to be a regular file inside the agent's own
;     state directory, and is re-hashed by this unit before anything is moved.
;
; That is the whole of the privilege this grants, stated so it can be argued
; with. An operator who does not want it leaves HCC_AGENT_AUTO_UPDATE=false,
; which is the default, and this unit never has a request to act on.

[Unit]
Description=Apply a verified Homelab Control Center agent update
Documentation=https://github.com/felixstaude/homelab-control-center
; Not `Requires=hcc-agent.service`: this unit replaces that service's binary
; and restarts it, so a dependency would be circular in effect.
After=network.target

; A loop here would reinstall on every trigger. `apply-update` removes the
; request before it acts, so a crash cannot loop — and this is the backstop
; for the case that reasoning is wrong.
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
; Root, for exactly as long as one install takes. The request is validated
; before anything is touched; see the command's own documentation.
User=root
Group=root
ExecStart=/usr/local/bin/hcc-agent apply-update

; --- Filesystem -------------------------------------------------------------
; This unit genuinely needs to write the binary, the unit directory is read
; only incidentally, and the state directory is where the request and the
; staged archive live.
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/usr/local/bin /var/lib/hcc-agent /etc/hcc-agent

; --- Privileges -------------------------------------------------------------
; Root without the privileges an installer does not need. Not an empty
; CapabilityBoundingSet: replacing a file owned by another user and
; chown-ing the result need DAC_OVERRIDE, CHOWN and FOWNER.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETUID CAP_SETGID
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
; MemoryDenyWriteExecute is deliberately absent: this unit extracts and
; executes a freshly installed binary to read its version, and a W^X
; restriction on the process doing that is a restriction on the dynamic
; loader.

; --- Resource bounds --------------------------------------------------------
; An install is a few megabytes of tar and one process spawn. A runaway here
; is a bug, and a bounded one is easier to diagnose than a full disk.
TimeoutStartSec=600
MemoryMax=256M
TasksMax=32

; --- Logging ----------------------------------------------------------------
; `journalctl -u hcc-agent-update` is where the privileged half of an update
; is read. Separate from the agent's own identifier on purpose: "what did root
; do to this machine" is a different question from "what is the agent doing".
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hcc-agent-update
