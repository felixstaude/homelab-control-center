# Homelab Control Center agent configuration.
#
# Install to /etc/hcc-agent/agent.env, owned by root, mode 0644.
#
# This file holds **no secret**, which is why 0644 is correct for it. The
# agent credential lives in a separate file the agent reads at the point of
# use (HCC_AGENT_CREDENTIAL_FILE, mode 0600), so a configuration file an
# administrator can read without sudo cannot leak a credential.
#
# systemd's EnvironmentFile does not run a shell: there is no quoting, no
# expansion and no comments at the end of a line. `A=b # c` sets A to the
# literal `b # c`.

# --- Required ---------------------------------------------------------------

# The control plane's base URL. Must be https, with one exception: plain http
# is permitted when the host is loopback, for a controller running on this
# same machine. Anything else is refused at startup rather than warned about —
# plain HTTP would send this host's credential in the clear.
HCC_AGENT_CONTROLLER_URL=https://hcc.example.com

# --- Optional ---------------------------------------------------------------

# Where the long-lived agent credential lives. The default is shown; override
# it only if you have a reason. The agent refuses to use a credential file
# that is group- or world-readable, is a symbolic link, is owned by another
# user, or sits in a directory other users can write to.
#HCC_AGENT_CREDENTIAL_FILE=/etc/hcc-agent/credential

# An extra CA bundle to trust, in addition to the system roots. For an
# internal CA you would rather not install host-wide.
#
# There is deliberately no setting that skips certificate verification. If the
# agent cannot verify your controller, the fix is a certificate it can verify —
# either one from a public CA or your own CA trusted here.
#HCC_AGENT_CA_FILE=/etc/hcc-agent/ca.pem

# debug | info | warn | error
#HCC_AGENT_LOG_LEVEL=info

# text | json. Use json if you ship logs somewhere that parses them; journald
# reads either.
#HCC_AGENT_LOG_FORMAT=text

# Reconnection backoff bounds. The defaults are shown. The minimum exists so a
# controller restart is not met with a reconnection storm from the whole
# fleet; the maximum so a host does not stay invisible long after a brief
# outage has ended. Neither can be set to zero.
#HCC_AGENT_RECONNECT_MIN_WAIT=2s
#HCC_AGENT_RECONNECT_MAX_WAIT=60s

# How long graceful shutdown may take before the process exits regardless.
#HCC_AGENT_SHUTDOWN_TIMEOUT=10s

# --- Enrollment only --------------------------------------------------------
#
# These are read by `hcc-agent enroll` and by nothing else. Do **not** put
# them in this file: it is readable by every local user, and an enrollment
# credential is a live secret for fifteen minutes.
#
# Pass them on the enroll command's own environment instead, e.g.
#
#   sudo HCC_AGENT_ENROLLMENT_TOKEN_FILE=/root/token hcc-agent enroll
#
# The file form is preferred over HCC_AGENT_ENROLLMENT_TOKEN because the
# environment of a running process is readable through /proc/<pid>/environ and
# is inherited by every child process it spawns.
#
#HCC_AGENT_ENROLLMENT_TOKEN_FILE=/root/hcc-enrollment-token
#HCC_AGENT_ENROLLMENT_TOKEN=
