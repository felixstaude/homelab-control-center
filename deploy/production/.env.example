# Homelab Control Center — deployment configuration.
#
#   cp .env.example .env
#   $EDITOR .env
#
# `.env` is read by Docker Compose. NEVER commit it, and note that it holds no
# secret: the database password is generated into ./secrets/db_password by the
# stack itself and no application signing key exists (sessions are
# server-side, so nothing is signed — see ADR-027 and ADR-028).

# ===========================================================================
# REQUIRED — one setting
# ===========================================================================
# The origin a BROWSER uses to reach this deployment, scheme included.
#
# Startup fails without it, deliberately. The application otherwise cannot
# know which origin browsers use, so the CSRF Origin check has nothing to
# compare against — and the failure that produces is a login that works and a
# logout that does not, reported as a CSRF error naming the wrong cause.
HCC_PUBLIC_ORIGIN=https://hcc.example.com

# ===========================================================================
# With compose.tls.yaml — the bundled Caddy
# ===========================================================================
# The hostname on the certificate. Usually HCC_PUBLIC_ORIGIN without the
# scheme.
# HCC_SITE_ADDRESS=hcc.example.com
#
# Empty for a publicly resolvable name: Caddy gets a Let's Encrypt
# certificate on its own.
#
# For a LAN-only name Let's Encrypt cannot validate, one of:
#   HCC_TLS_DIRECTIVE=tls internal
#     Caddy issues from its own CA. You must then install that CA on the
#     machines that use the interface, AND pass it to every agent:
#       sudo ./hcc-agent install --controller https://… --ca-file /path/ca.pem
#     The CA is at /data/caddy/pki/authorities/local/root.crt inside the
#     caddy-data volume.
#   HCC_TLS_DIRECTIVE=tls /tls/cert.pem /tls/key.pem
#     Serves a certificate you already have. Put it in ./tls/.
# HCC_TLS_DIRECTIVE=
#
# HCC_HTTP_PORT=80
# HCC_HTTPS_PORT=443

# ===========================================================================
# Without compose.tls.yaml — an existing reverse proxy
# ===========================================================================
# The controller publishes this port on 127.0.0.1 for your proxy to reach.
# Nothing on the LAN can see it.
#
# Your proxy must set X-Forwarded-For and X-Forwarded-Proto, and must pass
# WebSocket upgrades through — the agent connection is a WebSocket, so a proxy
# that does not will serve the interface and silently fail every host.
# See docs/DEPLOYMENT.md.
# HCC_BIND_PORT=8000
#
# Which addresses' forwarded headers to believe. Preset in compose.yaml to the
# private ranges a Compose bridge uses, because on single-host Compose the
# proxy is a sibling container and loopback is the wrong answer.
#
# Narrow it to your proxy's actual address if you can: trusting a wide range
# means anything on that network can forge its own source address and bypass
# per-address login throttling.
# HCC_TRUSTED_PROXIES=["172.16.0.0/12"]

# ===========================================================================
# Optional
# ===========================================================================
# DEBUG | INFO | WARNING | ERROR
# HCC_LOG_LEVEL=INFO

# How long measurements are kept, per resolution tier. Raw samples are the
# expensive ones; see docs/DATA_RETENTION.md for the volume figures.
# HCC_METRICS_RAW_RETENTION_DAYS=7
# HCC_METRICS_5M_RETENTION_DAYS=90
# HCC_METRICS_1H_RETENTION_DAYS=730

# Whether the container runs `alembic upgrade head` before binding a port.
#
# True is the default and is what makes `docker compose up -d` an
# installation. Set it false to run the migration yourself and watch it:
#   docker compose run --rm hcc migrate
# HCC_AUTO_MIGRATE=true

# Point at an existing PostgreSQL instead of the bundled one. Setting this
# makes the stack ignore ./secrets/db_password entirely, and you own the
# password's safety. Percent-encode anything exotic in it.
# HCC_DATABASE_URL=postgresql://user:password@db.example.com:5432/hcc

# For a build from source rather than a published image, with
# compose.build.yaml. These only label the image.
# HCC_VERSION=0.1.0
# HCC_COMMIT=abc123
# HCC_BUILD_DATE=2026-10-14T00:00:00Z
