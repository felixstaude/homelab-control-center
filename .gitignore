# ---- Secrets (never commit) ----
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
id_rsa*
id_ecdsa*
id_ed25519*
!**/testdata/**/*.pem
secrets/
# The deployment design has the Compose stack generate its own database
# password into this path; it must never be the thing that gets committed.
deploy/secrets/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# ---- Node ----
node_modules/
apps/web/dist/
apps/web/dev-dist/
.vite/

# ---- Browser end-to-end artefacts ----
# Traces and screenshots, kept only for a failing run (playwright.config.ts).
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/.playwright/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*

# ---- Go ----
agents/linux/bin/
*.test
*.out

# ---- Editors / OS ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ---- Local data / runtime ----
.data/
postgres-data/
*.sqlite3
*.db
*.log
# Database dumps. `pg_dump -Fc` output is a complete copy of the installation,
# including every password hash and agent credential digest.
*.dump
*.sql.gz

# ---- Misc ----
.direnv/
*~
*.tmp
